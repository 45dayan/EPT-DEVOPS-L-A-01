# Local Next.js process talking to Postgres on the host.
# Inside Docker Compose the host must be the database service name, not 127.0.0.1.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Required to file, update, or remove a row. Change this before a public deploy.
STUDIO_KEY=dayan-studio

DOCKERHUB_USERNAME=dayan45
